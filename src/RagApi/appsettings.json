{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Llm": {
    "Provider": "Ollama"
  },
  "Embeddings": {
    "Provider": "Ollama"
  },
  "VectorStore": "Qdrant",
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "EmbeddingModel": "nomic-embed-text",
    "ChatModel": "llama3.2:3b",
    "Temperature": 0.2
  },
  "ClaudeCode": {
    "Command": "claude",
    "Model": "haiku",
    "TimeoutSeconds": 180
  },
  "Claude": {
    "Model": "claude-haiku-5-5",
    "MaxTokens": 1024,
    "Temperature": 0.2
  },
  "Voyage": {
    "Model": "voyage-4"
  },
  "Qdrant": {
    "BaseUrl": "http://localhost:6333",
    "Collection": "documentos"
  },
  "Rag": {
    "DocsPath": "../../docs",
    "ChunkSize": 800,
    "ChunkOverlap": 150,
    "TopK": 4,
    "MinScore": 0.35,
    "EmbeddingBatchSize": 16,
    "MaxHistoryMessages": 6
  },
  "Agents": {
    "SkillsPath": "../../skills",
    "DataPath": "../../data",
    "MaxSteps": 4
  },
  "Eval": {
    "QuestionsPath": "../../eval/perguntas.json",
    "ResultsPath": "../../eval/resultados",
    "AgentQuestionsPath": "../../eval/agentes.json"
  }
}
