{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "ollama-qdrant": {
      "commandName": "Project",
      "launchBrowser": true,
      "applicationUrl": "http://localhost:5080",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    "claude-code": {
      "commandName": "Project",
      "launchBrowser": true,
      "applicationUrl": "http://localhost:5080",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "Llm__Provider": "ClaudeCode",
        "Embeddings__Provider": "Ollama",
        "VectorStore": "InMemory"
      }
    },
    "claude-api-voyage": {
      "commandName": "Project",
      "launchBrowser": true,
      "applicationUrl": "http://localhost:5080",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "Llm__Provider": "Claude",
        "Embeddings__Provider": "Voyage",
        "VectorStore": "InMemory"
      }
    }
  }
}
